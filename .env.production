# 生产环境配置
# API基础路径（CI/CD 构建时通过注入 VITE_API_BASE_URL 覆盖此值）
# 若前后端同域部署（Nginx 反向代理），相对路径可直接生效；否则须注入完整 URL
VITE_API_BASE_URL=/api/v1

# 应用标题
VITE_APP_TITLE=资产管理系统

# Token加密密钥（CI/CD 构建时注入，或通过 .env.production.local 覆盖）
# VITE_TOKEN_CRYPTO_KEY=（勿提交真实密钥）

# 认证通道：auto=按设备自动检测（PC→cookie、移动端→bearer）
# 可选值：auto | cookie | bearer（显式指定可覆盖自动检测）
VITE_AUTH_CHANNEL=auto