{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "cleanTempDir": "always",
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "reporters": ["clear-text", "html", "json"],
  "mutate": [
    "src/stores/**/*.ts",
    "src/composables/useGroup*.ts",
    "!src/stores/**/*.spec.ts",
    "!src/stores/**/__tests__/**/*.ts",
    "!src/stores/**/*.test.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 80
  },
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": true
  },
  "timeoutMS": 30000,
  "timeoutFactor": 2
}
